{
  "name": "server",
  "module": "src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=dev bun run --watch src/server.ts",
    "start": "cross-env NODE_ENV=production bun run src/server.ts",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose -f ../docker-compose.yml up -d",
    "infra:down": "docker compose -f ../docker-compose.yml down",
    "infra:stop": "docker compose -f ../docker-compose.yml stop",
    "db:migrate": "dotenv -e .env.dev npx prisma migrate dev",
    "db:generate": "dotenv -e .env.dev npx prisma generate",
    "db:studio": "dotenv -e .env.dev npx prisma studio",
    "db:push": "dotenv -e .env.dev npx prisma db push",
    "db:reset": "dotenv -e .env.dev npx prisma migrate reset --force"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.3",
    "@types/express-useragent": "^1.0.5",
    "@types/jsonwebtoken": "^9.0.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/s3-request-presigner": "^3.1057.0",
    "@google/genai": "^2.7.0",
    "@langchain/core": "^1.1.48",
    "@langchain/groq": "^1.2.1",
    "@langchain/langgraph": "^1.3.2",
    "@langchain/openai": "^1.4.7",
    "@langchain/tavily": "^1.2.0",
    "@prisma/client": "^6.16.3",
    "@types/nodemailer": "^7.0.2",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^10.0.0",
    "express": "^5.1.0",
    "express-jwt": "^8.5.1",
    "express-useragent": "^1.0.15",
    "http-errors": "^2.0.0",
    "imagekit": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.7",
    "openai": "^6.39.1",
    "prisma": "^6.16.3",
    "winston": "^3.18.3",
    "zod": "^4.1.11"
  }
}
