# Copy this file to .env.dev for local development

# ── Server ────────────────────────────────────────────────────
NODE_ENV=dev
PORT=3333

# ── Database ──────────────────────────────────────────────────
# Matches docker-compose.yml defaults
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/socia?schema=public"

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ── Mail (MailHog — matches docker-compose.yml) ───────────────
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=none

# ── Frontend ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000



# ── AI (Tavily web search) ────────────────────────────────────
TAVILY_API_KEY=your-tavily-api-key

# ── AI — set ONE of these two providers ──────────────────────
# Groq (fast, free tier available — takes priority when set)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter (300+ models, used when GROQ_API_KEY is unset)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/owl-alpha
